{
  "name": "discord-orb-studio",
  "productName": "Discord Orb Studio",
  "version": "3.3.12",
  "description": "Discord Quest Companion",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "build": "electron-builder --win nsis",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win nsis portable",
    "runtime-manifest": "node scripts/write-runtime-manifest.js",
    "runtime-release-marker": "node scripts/write-runtime-release-marker.js",
    "prebuild": "node scripts/prepare-release.js",
    "test:updates": "node --test tests/*.test.js"
  },
  "keywords": [
    "discord",
    "quest",
    "automation",
    "heartbeat",
    "orb",
    "desktop"
  ],
  "author": "Helios",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.7.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "build": {
    "appId": "com.samchico.discordorbstudio",
    "productName": "Discord Orb Studio",
    "copyright": "Copyright © 2026 Discord Orb Studio",
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1033",
      "installerLanguages": [
        "en_US"
      ],
      "displayLanguageSelector": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Discord Orb Studio",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Discord.Orb.Studio.Setup.${version}.${ext}",
      "include": "assets/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "files": [
      "main.js",
      "update-manager.js",
      "release-notes.js",
      "CHANGELOG.md",
      "preload.js",
      "preload-launch.js",
      "quest-engine.js",
      "qr-auth.js",
      "token-detector.js",
      "runtime-manifest.json",
      "src/**/*",
      "assets/**/*"
    ]
  }
}
